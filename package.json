{
    "name": "ilakkanam",
    "version": "0.2.0",
    "type": "module",
    "description": "Ilakkanam",
    "main": "dist/ilakkanam.min.js",
    "module": "dist/ilakkanam.min.js",
    "exports": {
        ".": {
            "import": "./dist/ilakkanam.min.js",
            "require": "./dist/ilakkanam.min.js"
        }
    },
    "files": [
        "dist/",
        "lib/",
        "README.md",
        "LICENCE"
    ],
    "directories": {
        "test": "test"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "lint": "npx eslint",
        "dev": "npm run build && NO_UPDATE_CHECK=1 npx serve",
        "test": "npm run build && node scripts/run-tests.mjs",
        "coverage": "COVERAGE=1 npm run build && COVERAGE=1 node scripts/run-tests.mjs && npx nyc report"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deepestblue/ilakkanam.git"
    },
    "author": "Ambarish Sridharanarayanan",
    "license": "AGPL-3.0-only",
    "bugs": {
        "url": "https://github.com/deepestblue/ilakkanam/issues"
    },
    "homepage": "https://github.com/deepestblue/ilakkanam#readme",
    "sideEffects": false,
    "devDependencies": {
        "@eslint/css": "^2.0.1",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^9.0.0",
        "@html-eslint/eslint-plugin": "^0.68.0",
        "@stylistic/eslint-plugin": "^6.0.1",
        "esbuild": "^0.28.2",
        "esbuild-plugin-istanbul": "^0.3.0",
        "eslint": "^10.15.0",
        "eslint-plugin-qunit": "^8.2.6",
        "eslint-plugin-yml": "^3.10.0",
        "globals": "^17.14.0",
        "node-qunit-puppeteer": "^2.2.1",
        "nyc": "^18.0.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "puppeteer@24.42.0": true
    }
}
